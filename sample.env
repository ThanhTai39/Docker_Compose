# Initially customized by ThanhTai39 (04/02/2026)
# LƯU Ý:
# Với các phiên bản PHP <= 7.4 thì MySQL 8 KHÔNG được hỗ trợ do thiếu hỗ trợ PDO

# Dùng để xác định tên các container của bạn
COMPOSE_PROJECT_NAME=lamp

# Các giá trị có thể dùng: php54, php56, php71, php72, php73, php74, php8, php81, php82, php83, php84
PHPVERSION=php84
DOCUMENT_ROOT=./www
APACHE_DOCUMENT_ROOT=/var/www/html
VHOSTS_DIR=./config/vhosts
APACHE_LOG_DIR=./logs/apache2
PHP_INI=./config/php/php.ini
SSL_DIR=./config/ssl

# PHPMyAdmin
UPLOAD_LIMIT=512M
MEMORY_LIMIT=512M

# Xdebug
XDEBUG_LOG_DIR=./logs/xdebug
XDEBUG_PORT=9003
#XDEBUG_PORT=9000

# Các giá trị có thể dùng: mysql57, mysql8, mariadb103, mariadb104, mariadb105, mariadb106
#
# Dành cho người dùng Apple Silicon:
# Vui lòng chọn MariaDB làm Database. Oracle không build container MySQL cho kiến trúc ARM

DATABASE=mysql8
MYSQL_INITDB_DIR=./config/initdb
MYSQL_DATA_DIR=./data/mysql
MYSQL_LOG_DIR=./logs/mysql
MYSQL_CNF=./config/mysql/my.cnf

# Nếu bạn đã dùng cổng 80, bạn có thể đổi sang cổng khác
# (ví dụ: nếu máy đã cài Apache)
# HOST_MACHINE_UNSECURE_HOST_PORT=80
HOST_MACHINE_UNSECURE_HOST_PORT=9999

# Nếu bạn đã dùng cổng 443, bạn có thể đổi sang cổng khác
# (ví dụ: nếu máy đã cài Apache)
HOST_MACHINE_SECURE_HOST_PORT=443

# Nếu bạn đã dùng cổng 3306, bạn có thể đổi sang cổng khác
# (ví dụ: nếu máy đã cài MySQL)
HOST_MACHINE_MYSQL_PORT=3306

# Nếu bạn đã dùng cổng 8080, bạn có thể đổi sang cổng khác
# (ví dụ: nếu máy đã chạy phpMyAdmin)
# HOST_MACHINE_PMA_PORT=8080
HOST_MACHINE_PMA_PORT=9998
HOST_MACHINE_PMA_SECURE_PORT=8443

# Nếu bạn đã dùng cổng 6379, bạn có thể đổi sang cổng khác
# (ví dụ: nếu máy đã chạy Redis)
HOST_MACHINE_REDIS_PORT=6379

# Mật khẩu user root của MySQL
MYSQL_ROOT_PASSWORD=taint39

# Cấu hình database: tên user, mật khẩu và tên database
#
# Nếu bạn cần cấp quyền cho user docker truy cập nhiều database hơn database "docker"
# bạn có thể cấp quyền đó thông qua phpMyAdmin
MYSQL_USER=docker
MYSQL_PASSWORD=docker
MYSQL_DATABASE=docker
